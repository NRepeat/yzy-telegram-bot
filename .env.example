# .env.example

# DATABASE_URL is essential for Prisma to connect to the database.
# It can be set directly, or constructed from the individual variables below.
# If you prefer to use a direct URL, uncomment and modify this:
# DATABASE_URL="postgresql://user:password@localhost:5432/yzy-bot"

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_WEBHOOK_URL=YOUR_WEBHOOK_URL

# Database Configuration
DATABASE_NAME=yzy-bot
DATABASE_HOST=db
DATABASE_USER=user
DATABASE_PASS=password
DATABASE_PORT=5432

# Admin Key
ADMIN_KEY=YOUR_ADMIN_KEY
